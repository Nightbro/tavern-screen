{
  "name": "tavern-screen",
  "version": "1.0.0",
  "description": "Fullscreen map display app for tabletop RPG sessions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "build": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nightbro/tavern-screen.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nightbro/tavern-screen/issues"
  },
  "homepage": "https://github.com/Nightbro/tavern-screen#readme",
  "build": {
    "appId": "com.tavernscreen.app",
    "productName": "Tavern Screen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "windowManager.js",
      "displayManager.js",
      "library.js",
      "config.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jest": "^30.3.0"
  }
}
